# Application
DEBUG=true
DJANGO_SECRET_KEY=dev-secret-change-me-to-32-plus-bytes-e4a1f9c2
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://conmeet:conmeet@localhost:5433/conmeet

# CORS / CSRF (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend (OAuth callback redirect target)
FRONTEND_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379/0

# Discord OAuth (register app, then set redirect URI to)
#   http://localhost:8000/accounts/discord/login/callback/
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth (redirect URI)
#   http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 API Token -> Access Key ID
R2_ACCESS_KEY_ID=
# Cloudflare R2 API Token -> Secret Access Key
R2_SECRET_ACCESS_KEY=
# Name of your public R2 bucket in Cloudflare
R2_BUCKET_PUBLIC=conmeet-media
# Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Public access URL: either your custom domain (https://media.conmeet.moe) or R2 dev URL (https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=
# Region (Cloudflare defaults to 'auto')
R2_REGION_NAME=auto