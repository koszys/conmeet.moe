# Application
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://conmeet:conmeet@localhost:5432/conmeet

# Auth
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_NAME=conmeet_session
AUTH_COOKIE_SECURE=false

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=conmeet-media
R2_BUCKET_PRIVATE=conmeet-uploads
R2_PUBLIC_URL=
R2_ENDPOINT_URL=